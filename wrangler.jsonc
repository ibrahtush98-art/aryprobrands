{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aryprobrands",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".wrangler/**",
      "package.json",
      "package-lock.json",
      "*.log",
      "*.py"
    ]
  }
}
